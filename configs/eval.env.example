# MPIE-Bench evaluation config (copy to configs/eval.env and edit).
# Do NOT commit real API keys. Prefer exporting secrets in your shell instead.

# --- Required paths ---
# Default: in-repo official pack. Override if you keep a local copy elsewhere.
export MPIE_TEST_PACK="${MPIE_TEST_PACK:-$PWD/data/testset}"
export MPIE_WEIGHTS="${MPIE_WEIGHTS:-$HOME/mpie_weights}"
export MULTIHMR_REPO="${MULTIHMR_REPO:-$HOME/models/multi-hmr}"

# Optional: official open-source model repos (for generation runners only)
# export MPIE_CODE="$HOME/models"

# --- Conda / Python ---
# Default: activate these envs. Override with absolute python paths if preferred.
export MPIE_EVAL_ENV="${MPIE_EVAL_ENV:-mpie}"          # ArcFace / HPSv2 / VLM clients
export MPIE_MESH_ENV="${MPIE_MESH_ENV:-multihmr}"      # Multi-HMR Anat+Inter
# export PYTHON_MPIE=/path/to/conda/envs/mpie/bin/python
# export PYTHON_MESH=/path/to/conda/envs/multihmr/bin/python

# --- Parallelism ---
export NGPU="${NGPU:-1}"                 # GPU shards for ID / Qual / Mesh
export VLM_WORKERS="${VLM_WORKERS:-8}"   # HTTP workers for Count + Instr

# --- VLM judge gateway (Count + Instr) ---
# OpenAI-compatible chat/completions endpoint + key
export AI_GATEWAY_URL="${AI_GATEWAY_URL:-}"
export AI_GATEWAY_KEY="${AI_GATEWAY_KEY:-}"
# Aliases used by some scripts:
# export AI_GATEWAY_KEY=...
# export MPIE_VLM_KEY=...
export MPIE_JUDGE_MODEL="${MPIE_JUDGE_MODEL:-gpt-5.5}"

# --- Optional limits (0 = full pack) ---
export EVAL_LIMIT="${EVAL_LIMIT:-0}"

# --- Aggregate HTML/JSON output ---
export MPIE_EVAL_OUT="${MPIE_EVAL_OUT:-$PWD/data/eval_outputs/latest}"
